@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Manage photo retention
Person(actor0, "Studio administrator", "Uses the Admin application")
System_Boundary(studio, "Quinntyne Brown Studio") {
 Container(app0, "Admin application", "Angular", "Manage photo retention")
 Container(api, "QuinntyneBrownStudio.Api", ".NET controllers", "Authorization and feature dispatch")
 ContainerDb(db, "Studio database", "Azure SQL", "Metadata and transactional state")
 Container(worker, "QuinntyneBrownStudio.Worker", ".NET on Container Apps", "Durable background processing")
 ContainerQueue(queue, "Processing queue", "Azure Storage Queues", "At-least-once work delivery")
}
Rel(actor0, app0, "Uses", "HTTPS")
Rel(app0, api, "Calls through shared-origin gateway", "JSON/HTTPS")
Rel(api, db, "Reads and commits metadata", "EF Core")
Rel(worker, db, "Relays SQL outbox and updates job state")
Rel(worker, queue, "Enqueues outbox work and consumes jobs")
System_Ext(ext, "Private photo storage", "Delete eligible original and derivative keys")
Rel(worker, ext, "Delete eligible original and derivative keys", "HTTPS")
@enduml

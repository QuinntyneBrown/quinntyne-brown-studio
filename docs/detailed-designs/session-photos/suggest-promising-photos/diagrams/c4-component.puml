@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Suggest promising photos
Container_Boundary(frontend, "Frontend - Admin applications") {
 Component(page, "PhotoSuggestionsPanel", "Angular", "Feature inputs, status, and results")
 Component(client, "IAnalysisService", "Interface and injection token", "Typed feature service boundary")
}
Container_Boundary(api, "Backend - QuinntyneBrownStudio.Api and Application") {
 Component(ctrl, "AnalysisController", ".NET controller", "Endpoint authorization and dispatch")
 Component(handler0, "RequestPhotoAnalysisHandler", "MediatR", "RequestPhotoAnalysis")
 Component(entity, "PhotoAnalysis", "Domain model", "Feature state and policy")
 Component(store, "IStudioStore", "Application port", "Transactional persistence boundary")
}
Container_Boundary(worker, "Backend - QuinntyneBrownStudio.Worker") {
 Component(job0, "AnalyzePhotoHandler", "Background handler", "AnalyzePhoto")
}
Rel(page, client, "Consumes token contract")
Rel(client, ctrl, "Calls typed controller API", "HTTPS")
Rel(ctrl, handler0, "Dispatches request")
Rel(handler0, entity, "Uses state and policy")
Rel(handler0, store, "Loads or saves authorized state")
Rel(job0, entity, "Applies background transition")
Rel(job0, store, "Checks durable job and saves result")
Component(ext, "IPhotoAnalysisService", "Application port", "Assess technical quality using a versioned rubric")
Rel(job0, ext, "Calls provider adapter")
@enduml

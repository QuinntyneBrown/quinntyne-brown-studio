@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - CreateUploadBatch
actor "Studio administrator" as actor
box "Frontend - Admin application" #E0F2FE
 participant "SessionUploadPage" as page
 participant "IUploadService" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "UploadsController" as controller
end box
box "Backend - Qbs.Application and Domain" #ECFDF3
 participant "CreateUploadBatchHandler" as handler
 participant "UploadBatch" as entity
end box
box "Backend - Qbs.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
 participant "IPhotoStorage adapter" as ext
end box
actor -> page : Start CreateUploadBatch
page -> client : Build typed request
client -> controller : POST /api/admin/sessions/{sessionId}/uploads
controller -> controller : Authenticate; enforce role and resource policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch CreateUploadBatch
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> ext : Issue one scoped staging write grant per accepted file (L2-059)
ext --> handler : Typed provider result or failure
handler -> entity : Validate manifest\nsave batch and issue per-file scoped write grants (L2-026)
note right of entity
L2-026, L2-027, L2-028, L2-059
L2-060, L2-069
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Excess batch: 400; invalid individual files: explicit rejection outcomes
else Operation succeeds
handler -> db : Commit revision and any outbox jobs atomically
db --> handler : Commit acknowledgement
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present manifest grants and rejected files
loop Accepted files, at most four active
page -> ext : Stage 8 MiB blocks with scoped write grant (L2-059)
ext --> page : Acknowledged block or transfer failure
page -> page : Persist block progress; retain independent file state (L2-028)
end
page -> client : Finalize each completed file through API
end
end
@enduml

@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Upload session photos
Container_Boundary(frontend, "Frontend - Admin applications") {
 Component(page, "SessionUploadPage", "Angular", "Feature inputs, status, and results")
 Component(client, "IUploadService", "Interface and injection token", "Typed feature service boundary")
}
Container_Boundary(api, "Backend - Qbs.Api and Application") {
 Component(ctrl, "UploadsController", ".NET controller", "Endpoint authorization and dispatch")
 Component(handler0, "SaveSessionHandler", "MediatR", "SaveSession")
 Component(handler1, "CreateUploadBatchHandler", "MediatR", "CreateUploadBatch")
 Component(handler2, "FinalizeUploadFileHandler", "MediatR", "FinalizeUploadFile")
 Component(entity, "UploadBatch", "Domain model", "Feature state and policy")
 Component(store, "IStudioStore", "Application port", "Transactional persistence boundary")
}
Container_Boundary(worker, "Backend - Qbs.Worker") {
 Component(job0, "CreatePhotoPreviewHandler", "Background handler", "CreatePhotoPreview")
}
Rel(page, client, "Consumes token contract")
Rel(client, ctrl, "Calls typed controller API", "HTTPS")
Rel(ctrl, handler0, "Dispatches request")
Component(session, "Session", "Domain entity", "Stable photo association and planned timing")
Rel(handler0, session, "Updates timing and identity")
Rel(handler0, store, "Loads or saves authorized state")
Rel(ctrl, handler1, "Dispatches request")
Rel(handler1, entity, "Uses state and policy")
Rel(handler1, store, "Loads or saves authorized state")
Rel(ctrl, handler2, "Dispatches request")
Rel(handler2, entity, "Uses state and policy")
Rel(handler2, store, "Loads or saves authorized state")
Component(photo, "SessionPhoto", "Domain entity", "Original and preview readiness")
Component(converter, "IRawPreviewConverter", "Application port", "Decodes supported camera originals")
Rel(job0, photo, "Marks preview readiness")
Rel(job0, converter, "Creates oriented derivatives")
Rel(job0, store, "Checks durable job and saves result")
Component(ext, "IPhotoStorage", "Application port", "Transfer originals and retain derived previews")
Rel(job0, ext, "Calls provider adapter")
Rel(handler1, ext, "Calls provider adapter")
Rel(handler2, ext, "Calls provider adapter")
@enduml

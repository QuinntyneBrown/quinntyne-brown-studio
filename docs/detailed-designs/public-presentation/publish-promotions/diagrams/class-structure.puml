@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Publish promotions
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class Promotion {
 +Guid Id
 +string Title
 +string Description
 +Money IndicativePrice
 +bool Published
 +long Version
 +Publish(): void
}
class Money <<value object>> {
 +decimal Amount
 +string Currency
 +RoundToCents(): Money
}
Promotion ..> Money : uses CAD arithmetic
interface IStudioStore {
 +BeginTransaction(): IUnitOfWork
}
interface IUnitOfWork {
 +Commit(): Task
}
IStudioStore ..> IUnitOfWork : opens
IStudioStore o-- Promotion : persists or supplies inputs
@enduml

@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Publish galleries
Container_Boundary(frontend, "Frontend - Admin and Marketing applications") {
 Component(page, "PublicGalleryEditor", "Angular", "Feature inputs, status, and results")
 Component(client, "IPublicGalleryService", "Interface and injection token", "Typed feature service boundary")
}
Container_Boundary(api, "Backend - QuinntyneBrownStudio.Api and Application") {
 Component(ctrl, "PublicGalleryController", ".NET controller", "Administrative authorization and dispatch")
 Component(publicCtrl, "PresentationController", ".NET controller", "Anonymous projection endpoint")
 Component(handler0, "SavePublicGalleryHandler", "MediatR", "SavePublicGallery")
 Component(handler1, "GetPublicGalleryHandler", "MediatR", "GetPublicGallery")
 Component(entity, "PublicGallery", "Domain model", "Feature state and policy")
 Component(store, "IStudioStore", "Application port", "Transactional persistence boundary")
}
Rel(page, client, "Consumes token contract")
Rel(client, ctrl, "Calls the administrative controller API", "HTTPS")
Rel(client, publicCtrl, "Reads the anonymous projection", "HTTPS")
Rel(ctrl, handler0, "Dispatches request")
Rel(handler0, entity, "Uses state and policy")
Rel(handler0, store, "Loads or saves authorized state")
Rel(publicCtrl, handler1, "Dispatches request")
Rel(handler1, entity, "Uses state and policy")
Rel(handler1, store, "Loads or saves authorized state")
@enduml

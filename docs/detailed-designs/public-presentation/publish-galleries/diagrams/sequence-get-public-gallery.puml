@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - GetPublicGallery
actor "Public visitor" as actor
box "Frontend - Marketing application" #E0F2FE
 participant "PublicGalleryPage" as page
 participant "IPublicGalleryService" as client
end box
box "Backend - QuinntyneBrownStudio.Api application" #D1FADF
 participant "PresentationController" as controller
end box
box "Backend - QuinntyneBrownStudio.Application and Domain" #ECFDF3
 participant "GetPublicGalleryHandler" as handler
 participant "PublicGallery" as entity
end box
box "Backend - QuinntyneBrownStudio.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
end box
actor -> page : Start GetPublicGallery
page -> client : Build typed request
client -> controller : GET /api/public/galleries/{slug}
controller -> controller : Apply anonymous input policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch GetPublicGallery
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> entity : Select only published gallery and selected derivative references (L2-004)
note right of entity
L2-004, L2-005, L2-063
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Unpublished gallery or unselected photo: 404; no private bytes
else Operation succeeds
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

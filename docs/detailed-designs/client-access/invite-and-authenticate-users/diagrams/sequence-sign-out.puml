@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - SignOut
actor "Account holder" as actor
box "Frontend - Admin / Client application" #E0F2FE
 participant "AccountAccessPage" as page
 participant "IAuthService" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "AuthController" as controller
end box
box "Backend - Qbs.Application and Domain" #ECFDF3
 participant "SignOutHandler" as handler
 participant "StudioAccount" as entity
end box
box "Backend - Qbs.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
end box
actor -> page : Start SignOut
page -> client : Build typed request
client -> controller : POST /api/auth/logout
controller -> controller : Apply authentication endpoint and antiforgery policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch SignOut
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> entity : Validate antiforgery and clear session cookie (L2-003)
note right of entity
L2-003, L2-032, L2-062
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Invalid antiforgery: deny mutation
else Operation succeeds
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

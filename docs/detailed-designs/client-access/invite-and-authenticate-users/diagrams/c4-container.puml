@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Invite and authenticate users
Person(actor0, "Studio administrator", "Uses the Admin application")
Person(actor1, "Authenticated client", "Uses the Client application")
System_Boundary(studio, "Quinntyne Brown Studio") {
 Container(app0, "Admin application", "Angular", "Invite and authenticate users")
 Container(app1, "Client application", "Angular", "Invite and authenticate users")
 Container(api, "QuinntyneBrownStudio.Api", ".NET controllers", "Authorization and feature dispatch")
 ContainerDb(db, "Studio database", "Azure SQL", "Metadata and transactional state")
}
Rel(actor0, app0, "Uses", "HTTPS")
Rel(app0, api, "Calls through shared-origin gateway", "JSON/HTTPS")
Rel(actor1, app1, "Uses", "HTTPS")
Rel(app1, api, "Calls through shared-origin gateway", "JSON/HTTPS")
Rel(api, db, "Reads and commits metadata", "EF Core")
System_Ext(ext, "Azure Communication Services Email", "Deliver invitation and recovery token links")
Rel(api, ext, "Deliver invitation and recovery token links", "HTTPS")
@enduml

@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Assign and view session galleries
Container_Boundary(frontend, "Frontend - Admin and Client applications") {
 Component(page, "ClientGalleriesPage", "Angular", "Feature inputs, status, and results")
 Component(client, "IClientGalleriesApi", "Interface and injection token", "Typed feature service boundary")
}
Container_Boundary(api, "Backend - Qbs.Api and Application") {
 Component(ctrl, "ClientGalleriesController", ".NET controller", "Endpoint authorization and dispatch")
 Component(handler0, "SetGalleryAssignmentsHandler", "MediatR", "SetGalleryAssignments")
 Component(handler1, "GetClientGalleriesHandler", "MediatR", "GetClientGalleries")
 Component(handler2, "GetClientPhotoHandler", "MediatR", "GetClientPhoto")
 Component(entity, "GalleryAssignment", "Domain model", "Feature state and policy")
 Component(store, "IStudioStore", "Application port", "Transactional persistence boundary")
}
Rel(page, client, "Consumes token contract")
Rel(client, ctrl, "Calls typed controller API", "HTTPS")
Rel(ctrl, handler0, "Dispatches request")
Rel(handler0, entity, "Uses state and policy")
Rel(handler0, store, "Loads or saves authorized state")
Rel(ctrl, handler1, "Dispatches request")
Rel(handler1, entity, "Uses state and policy")
Rel(handler1, store, "Loads or saves authorized state")
Rel(ctrl, handler2, "Dispatches request")
Rel(handler2, entity, "Uses state and policy")
Rel(handler2, store, "Loads or saves authorized state")
Component(ext, "IPhotoStorage", "Application port", "Stream authorized client previews")
Rel(handler0, ext, "Uses when operation requires external data")
Rel(handler1, ext, "Uses when operation requires external data")
Rel(handler2, ext, "Uses when operation requires external data")
@enduml

@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - GetClientPhoto
actor "Authenticated client" as actor
box "Frontend - Client application" #E0F2FE
 participant "ClientGalleriesPage" as page
 participant "IPhotoService" as client
end box
box "Backend - QuinntyneBrownStudio.Api application" #D1FADF
 participant "PhotosController" as controller
end box
box "Backend - QuinntyneBrownStudio.Application and Domain" #ECFDF3
 participant "GetClientPhotoHandler" as handler
 participant "GalleryAssignment" as entity
end box
box "Backend - QuinntyneBrownStudio.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
 participant "IPhotoStorage adapter" as ext
end box
actor -> page : Start GetClientPhoto
page -> client : Build typed request
client -> controller : GET /api/client/photos/{photoId}/preview
controller -> controller : Authenticate; enforce role and resource policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch GetClientPhoto
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> ext : Stream authorized client previews
ext --> handler : Typed provider result or failure
handler -> entity : Recheck assignment and expiry before streaming private bytes (L2-033)
note right of entity
L2-033, L2-034, L2-063, L2-061
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Revoked, expired, or other-client photo: 404; no bytes
else Operation succeeds
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Browse the component catalog
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class CatalogEntry {
 +string Id
 +string Name
 +string Category
 +string[] Classes
 +string[] States
}
class ComponentExample {
 +string Id
 +string Title
 +string Description
 +string Markup
 +Render(): void
}
class ScenarioFamily {
 +string Id
 +string Name
 +string Description
}
CatalogEntry "1" *-- "1..*" ComponentExample : Catalogued example
ScenarioFamily "1" *-- "1..*" ComponentExample : Pattern or dialog scenario
@enduml

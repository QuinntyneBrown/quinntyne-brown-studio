@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - BuildCatalog
actor "Design contributor" as actor
box "Frontend - Design-system catalog" #E0F2FE
 participant "CatalogApplication" as page
 participant "ComponentManifest and fixtures" as client
end box
box "Delivery - Static catalog" #FFF4E5
 participant "CatalogBuild" as build
 participant "StaticArtifactPublisher" as host
end box
actor -> build : Request a validated catalog artifact
build -> client : Validate the manifest against styles and fixtures
client --> build : Contract result
build -> page : Run browser checks with product requests blocked
page --> build : Rendered examples and scenarios
alt Validated artifact
build --> actor : Artifact directory and revision
else Contract, browser, or compile failure
build --> actor : Failure; the deployed revision is unchanged
end
note over page, host
Build the catalog and verify every asset with the studio backend blocked
L2-046, L2-048
No studio backend participates.
end note
@enduml

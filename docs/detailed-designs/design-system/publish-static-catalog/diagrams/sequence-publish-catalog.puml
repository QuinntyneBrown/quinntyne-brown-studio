@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - PublishCatalog
actor "Design contributor" as actor
box "Frontend - Design-system catalog" #E0F2FE
 participant "CatalogApplication" as page
 participant "ComponentManifest and fixtures" as client
end box
box "Delivery - Static catalog" #FFF4E5
 participant "CatalogBuild" as build
 participant "StaticArtifactPublisher" as host
end box
actor -> build : Publish the validated artifact
build -> host : Upload the complete versioned directory
host --> build : Deployment result
alt Deep links and assets resolve
build --> actor : Published revision
else Deployment smoke failure
build -> host : Restore the prior artifact
build --> actor : Failure and restored revision
end
note over page, host
Publish a validated versioned artifact and check deep links
L2-046, L2-048
No studio backend participates.
end note
@enduml

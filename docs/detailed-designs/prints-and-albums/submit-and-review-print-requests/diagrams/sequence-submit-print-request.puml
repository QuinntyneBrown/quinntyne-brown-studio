@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - SubmitPrintRequest
actor "Authenticated client" as actor
box "Frontend - Client application" #E0F2FE
 participant "PrintRequestPage" as page
 participant "IPrintRequestsApi" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "PrintRequestsController" as controller
end box
box "Backend - Qbs.Application and Domain" #ECFDF3
 participant "SubmitPrintRequestHandler" as handler
 participant "PrintRequest" as entity
end box
box "Backend - Qbs.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
end box
actor -> page : Start SubmitPrintRequest
page -> client : Build typed request
client -> controller : POST /api/client/print-requests
controller -> controller : Authenticate; enforce role and resource policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch SubmitPrintRequest
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> entity : Authorize each photo\nverify prices\ndeduplicate and commit immutable request snapshot (L2-035)
note right of entity
L2-035, L2-036, L2-034, L2-064
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Photo denied: 404; stale prices or changed retry payload: 409; store failure: no success
else Operation succeeds
handler -> db : Commit revision and any outbox jobs atomically
db --> handler : Commit acknowledgement
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

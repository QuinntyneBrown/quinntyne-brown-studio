@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - ReviewPrintRequest
actor "Studio administrator" as actor
box "Frontend - Admin application" #E0F2FE
 participant "PrintRequestInboxPage" as page
 participant "IPrintRequestService" as client
end box
box "Backend - QuinntyneBrownStudio.Api application" #D1FADF
 participant "PrintRequestsController" as controller
end box
box "Backend - QuinntyneBrownStudio.Application and Domain" #ECFDF3
 participant "ReviewPrintRequestHandler" as handler
 participant "PrintRequest" as entity
end box
box "Backend - QuinntyneBrownStudio.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
end box
actor -> page : Start ReviewPrintRequest
page -> client : Build typed request
client -> controller : POST /api/admin/print-requests/{id}/review
controller -> controller : Authenticate; enforce role and resource policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch ReviewPrintRequest
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> entity : Record review actor and time\npreserve submitted prices (L2-035)
note right of entity
L2-035, L2-036, L2-034, L2-064
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Stale version: 409; no false fulfilment state
else Operation succeeds
handler -> db : Commit revision and any outbox jobs atomically
db --> handler : Commit acknowledgement
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

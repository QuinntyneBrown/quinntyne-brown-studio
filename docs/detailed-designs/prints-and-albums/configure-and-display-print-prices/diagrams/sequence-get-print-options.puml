@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - GetPrintOptions
actor "Public visitor" as actor
box "Frontend - Marketing application" #E0F2FE
 participant "PublicPrintPricesPage / ClientPrintSelectionPage" as page
 participant "IPrintOptionsApi" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "PrintOptionsController" as controller
end box
box "Backend - Qbs.Application and Domain" #ECFDF3
 participant "GetPrintOptionsHandler" as handler
 participant "PrintOption" as entity
end box
box "Backend - Qbs.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
end box
actor -> page : Start GetPrintOptions
page -> client : Build typed request
client -> controller : GET /api/public/print-options
controller -> controller : Apply anonymous input policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch GetPrintOptions
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> entity : Project current enabled options and revisions for both consumers (L2-006)
note right of entity
L2-006, L2-020, L2-035
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : Empty configuration: empty catalog; no sample prices
else Operation succeeds
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

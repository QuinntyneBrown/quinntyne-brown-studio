@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - ResolveQuoteLocation
actor "Public visitor" as actor
box "Frontend - Marketing application" #E0F2FE
 participant "QuoteCalculatorPage" as page
 participant "IQuoteService" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "QuotesController" as controller
end box
box "Backend - Qbs.Application and Domain" #ECFDF3
 participant "ResolveQuoteLocationHandler" as handler
 participant "QuoteCalculation" as entity
end box
box "Backend - Qbs.Infrastructure" #FFF4E5
 database "Studio database via IStudioStore" as db
 participant "IRouteDistanceService adapter" as ext
end box
actor -> page : Start ResolveQuoteLocation
page -> client : Build typed request
client -> controller : POST /api/public/locations/resolve
controller -> controller : Apply anonymous input policy
alt Access or request rejected
controller --> client : ProblemDetails; no protected result
client --> page : Correction or access state
else Request admitted
controller -> handler : Dispatch ResolveQuoteLocation
handler -> db : Load scoped state and configuration
db --> handler : Current snapshot
handler -> ext : Resolve addresses and calculate ordered driving route
ext --> handler : Typed provider result or failure
handler -> entity : Resolve address candidates without selecting ambiguous coordinates automatically (L2-008)
note right of entity
L2-008, L2-009, L2-010, L2-011
L2-012, L2-013, L2-055, L2-056
end note
entity --> handler : Validated result or policy failure
alt Operation fails
note right of handler : Failure leaves stored state unchanged
handler --> controller : Typed failure
controller --> client : ProblemDetails or field-level result
client --> page : No matching address or provider failure: correction state; no zero-distance fallback
else Operation succeeds
handler --> controller : Typed feature result
controller --> client : HTTP success
client --> page : Deliver response with request revision
page --> actor : Present confirmed result
end
end
@enduml

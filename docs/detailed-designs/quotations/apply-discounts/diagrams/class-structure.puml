}
class DiscountRule {
 +Guid Id
 +DiscountKind Kind
 +decimal Percentage
 +bool Enabled
 +DateOnly? ValidFrom
 +DateOnly? ValidThrough
}
DiscountPolicy "1" *-- "0..*" DiscountRule : Configured eligibility rule

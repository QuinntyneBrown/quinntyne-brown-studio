title Class structure - Check session availability
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class AvailabilityPolicy {
 +string Zone = America/Toronto
 +Evaluate(request: AvailabilityRequest, schedules: PhotographerSchedule[]): AvailabilityResult
}
class AvailabilityResult {
 +bool Available
 +Guid[] PhotographerIds
 +string? ReasonCode
}
AvailabilityPolicy "1" *-- "0..*" AvailabilityResult : Value returned for the requested interval
interface IStudioStore {
 +Run<T>(lockKey, action): Task<T>
}
interface IStudioTransaction {
 +Get<T>(id): Task<T?>
 +List<T>(): Task<T[]>
 +Save<T>(value, expectedVersion): Task
}
IStudioStore ..> IStudioTransaction : scopes one committed unit of work
IStudioStore o-- AvailabilityPolicy : persists or supplies inputs
@enduml

title Behavior - GetPhotographerSchedule
actor "Studio administrator" as actor
box "Frontend - Admin application" #E0F2FE
 participant "PhotographerSchedulePage" as page
 participant "ISchedulesApi" as client
end box
box "Backend - Qbs.Api application" #D1FADF
 participant "SchedulesController" as controller
end box

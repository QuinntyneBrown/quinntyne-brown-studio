{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "marketing": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/marketing",
      "sourceRoot": "projects/marketing/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/marketing/src/main.ts",
            "tsConfig": "projects/marketing/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/marketing/public"
              }
            ],
            "styles": ["projects/marketing/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "acceptance": {
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/application/src/lib/quote-provider.ts",
                  "with": "projects/application/src/lib/quote-provider.acceptance.ts"
                },
                {
                  "replace": "projects/application/src/lib/studio-providers.ts",
                  "with": "projects/application/src/lib/studio-providers.acceptance.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "marketing:build:production"
            },
            "development": {
              "buildTarget": "marketing:build:development"
            },
            "acceptance": {
              "buildTarget": "marketing:build:acceptance"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "admin": {

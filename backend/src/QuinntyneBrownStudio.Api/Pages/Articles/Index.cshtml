@page "/blog/articles"
@model QuinntyneBrownStudio.Api.Pages.Articles.ArticlesIndexModel
@inject IConfiguration Configuration
@{
    ViewBag.Title = $"Articles | {Configuration["Site:SiteName"] ?? "Quinntyne Brown Studio"}";
    ViewBag.Description = Configuration["Site:SiteDescription"] ?? "Photography, stories, and insights from Quinntyne Brown Studio.";
    ViewBag.CanonicalUrl = $"{((Configuration["PublicOrigin"] ?? "https://localhost:7443").TrimEnd('/') + "/blog")?.TrimEnd('/')}/articles";
    ViewBag.IsBlogListing = true;
}

<partial name="Shared/_BlogListing" model="Model.Articles" />

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Blog",
        "name": "@(Configuration["Site:SiteName"] ?? "Quinntyne Brown Studio")",
        "description": "@(Configuration["Site:SiteDescription"] ?? "Studio blog")",
        "url": "@(((Configuration["PublicOrigin"] ?? "https://localhost:7443").TrimEnd('/') + "/blog")?.TrimEnd('/'))/articles",
        "author": { "@@type": "Person", "name": "@(Configuration["Site:AuthorName"] ?? "Quinntyne Brown Studio")" }
    }
    </script>
}

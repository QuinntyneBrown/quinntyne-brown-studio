@using QuinntyneBrownStudio.Application.Blog.Articles.Queries
@using QuinntyneBrownStudio.Application.Blog.Models
@model PagedResponse<ArticleListDto>
@{
    var listingPath = ViewContext.HttpContext.Request.Path.Value ?? "/blog/";
}

<div class="blog-page">
    <header class="blog-head">
        <p class="blog-eyebrow">From the studio</p>
        <h1>Blog</h1>
        <p>Notes on making photographs feel easy, personal, and true to the people in them.</p>
    </header>

    @if (Model.Items.Count == 0)
    {
        <section class="blog-empty" aria-labelledby="blog-empty-title">
            <h2 id="blog-empty-title">No articles yet</h2>
            <p>Articles will appear here once they are published. Check back soon.</p>
        </section>
    }
    else
    {
        <section class="blog-grid" aria-label="Published articles">
            @foreach (var article in Model.Items)
            {
                <article class="blog-post">
                    <a href="/blog/articles/@article.Slug" aria-label="Read @article.Title">
                        <span class="blog-post-image">
                            @if (!string.IsNullOrEmpty(article.FeaturedImageUrl))
                            {
                                <img responsive src="@article.FeaturedImageUrl" alt=""
                                     img-width="@article.FeaturedImageWidth" img-height="@article.FeaturedImageHeight"
                                     breakpoints="320,640,960"
                                     sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
                                     priority="false" />
                            }
                            else
                            {
                                <span class="blog-post-image-placeholder" aria-hidden="true"></span>
                            }
                        </span>
                        <time datetime="@article.DatePublished?.ToString("yyyy-MM-dd")">@article.DatePublished?.ToString("MMMM d, yyyy")</time>
                        <h2>@article.Title</h2>
                    </a>
                </article>
            }
        </section>

        @if (Model.TotalPages > 1)
        {
            <nav class="blog-pagination" aria-label="Pagination">
                @if (Model.HasPreviousPage)
                {
                    <a href="@listingPath?page=@(Model.Page - 1)" rel="prev">Previous</a>
                }
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a href="@listingPath?page=@pageNumber" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="@listingPath?page=@(Model.Page + 1)" rel="next">Next</a>
                }
            </nav>
        }
    }
</div>

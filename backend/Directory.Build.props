<Project>
  <!--
    SixLabors.ImageSharp 3.1.12 is the last line usable without a Six Labors license key:
    4.x fails the build unless $(SixLaborsLicenseKey) or a sixlabors.lic file is present.
    Every 3.x release carries these advisories, so NuGet audit is suppressed for them until
    the studio either obtains a license and moves to 4.1.2+, or replaces ImageSharp with
    SkiaSharp, which the solution already references.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>

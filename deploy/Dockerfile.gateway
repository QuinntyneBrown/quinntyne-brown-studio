FROM node:24.18.0 AS build
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
COPY scripts /src/scripts
RUN npm run build:apps
FROM nginx:stable-alpine
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/frontend/dist/marketing/browser /usr/share/nginx/html
COPY --from=build /src/frontend/dist/admin/browser /usr/share/nginx/html/admin
COPY --from=build /src/frontend/dist/client/browser /usr/share/nginx/html/client
ENV API_UPSTREAM=http://api:8080
EXPOSE 8080

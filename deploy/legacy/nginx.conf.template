server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 9m;
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
    location = /admin { return 308 /admin/; }
    location = /client { return 308 /client/; }
    location /admin/ { try_files $uri $uri/ /admin/index.html; }
    location /client/ { try_files $uri $uri/ /client/index.html; }
    location / { try_files $uri $uri/ /index.html; }
    location ~* \.(js|css|woff2)$ { try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; }
    location ~* \.html$ { add_header Cache-Control "no-cache"; }
}
